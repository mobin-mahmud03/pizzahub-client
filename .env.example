# Database (same database MongoDB URI the Express server uses)
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahub

# Better Auth secret and URL
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Backend API server URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth credentials (optional for development)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
